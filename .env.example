# ============================================================
# MOVE TOGETHER – Variabili d'Ambiente
# Copia questo file in .env e compila i valori reali.
# NON committare mai il file .env su GitHub!
# ============================================================

PORT=3000

# ── Servizio Email ──────────────────────────────────────────
# Opzioni: 'gmail' | 'sendgrid' | 'mailgun'
# Lascia vuoto per disabilitare l'invio email (log only)
EMAIL_SERVICE=gmail

# ── Gmail SMTP ──────────────────────────────────────────────
# 1. Attiva 2FA sul tuo account Google
# 2. Vai su myaccount.google.com > Sicurezza > Password per le app
# 3. Crea una App Password e usa quella qui (16 caratteri, senza spazi)
EMAIL_USER=la-tua-email@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop

# ── SendGrid (alternativa) ───────────────────────────────────
# Crea un account su sendgrid.com, genera una API Key con permesso "Mail Send"
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Mailgun (alternativa) ────────────────────────────────────
MAILGUN_USER=postmaster@mg.tuodominio.it
MAILGUN_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_SMTP_HOST=smtp.mailgun.org

# ── Email destinatario notifiche ANIF ───────────────────────
ANIF_EMAIL=info@anifeurowellness.it

# ── Chiave segreta Admin Dashboard ──────────────────────────
# Cambiala con qualcosa di sicuro prima del deploy!
ADMIN_SECRET=anif_rimini_wellness_2025
